{
  "name": "Universal Data Permission Layer",
  "description": "Comprehensive cross-platform data permission layer: cookie consent auto-handling + GPC header + Topics API opt-out + policy engine + encrypted sync + audit dashboard",
  "version": "0.1.0",
  "manifest_version": 3,
  "author": "Daniel Milanesi",
  "homepage_url": "https://github.com/JuicyLies/UniversalDataPermissionLayer",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Universal Data Permission Layer",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "assets/icons/icon_48.png",
    "96": "assets/icons/icon_96.png",
    "128": "assets/icons/icon_128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "udp@juicylies.dev",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    "Rules.json"
  ]
}
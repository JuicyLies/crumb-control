{
  "name": "Crumb Control",
  "description": "Automatic cookie consent handling, GPC signal, and a local privacy policy engine \u2014 no accounts, no cloud, no tracking.",
  "version": "0.4.0",
  "manifest_version": 3,
  "author": "Daniel Milanesi",
  "homepage_url": "https://github.com/JuicyLies/crumb-control",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Crumb Control",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon_16.png",
      "32": "assets/icons/icon_32.png",
      "48": "assets/icons/icon_48.png",
      "128": "assets/icons/icon_128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon_16.png",
    "32": "assets/icons/icon_32.png",
    "48": "assets/icons/icon_48.png",
    "96": "assets/icons/icon_96.png",
    "128": "assets/icons/icon_128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "udp@juicylies.dev",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    "Rules.json"
  ]
}
